# Copiá este archivo como .env para probar en tu compu.
# En Hostinger NO subas el .env: cargá estas variables en el panel de la Web App.

# Contraseña del panel /admin
ADMIN_PASSWORD=una-clave-segura

# Base MySQL (en Hostinger: hPanel → Bases de datos → Administración)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=u123456789_properhouse
DB_PASSWORD=la-clave-de-la-base
DB_NAME=u123456789_properhouse

# Opcional: texto largo y aleatorio para firmar la sesión del admin
SESSION_SECRET=

# Resumen del turno por mail (casilla de Hostinger u otro SMTP). Ver README.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=Proper House
MAIL_REPLY_TO=
MAIL_COPIA=
